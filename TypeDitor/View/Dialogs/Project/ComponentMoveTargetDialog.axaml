<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TypeDitor.View.Dialogs.Project.ComponentMoveTargetDialog"
        Title="Move node to..."
        WindowStartupLocation="CenterOwner"
        Width="420" Height="480">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock x:Name="tbMessage" Margin="0,0,0,8"/>
        <TreeView x:Name="tvNodes" Grid.Row="1" DoubleTapped="Tree_DoubleTapped" KeyDown="Tree_KeyDown">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Title}"/>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
