<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TypeDitor.View.Dialogs.Project.IconSelectorDialog"
        Title="Select icon"
        WindowStartupLocation="CenterOwner"
        Width="520" Height="480">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox x:Name="tbFilter" PlaceholderText="Filter icons..." TextChanged="Filter_TextChanged"/>
            <Button Grid.Column="1" Content="_Import..." Margin="8,0,0,0" Click="Import_Click"/>
        </Grid>
        <ListBox x:Name="lbIcons" Grid.Row="1" DoubleTapped="Icons_DoubleTapped" KeyDown="Icons_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="84" Spacing="2" ToolTip.Tip="{Binding Name}">
                        <Image Source="{Binding Image}" Width="32" Height="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
