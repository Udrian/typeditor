<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TypeDitor.View.Dialogs.Project.ContentReferencesDialog"
        Title="Content is in use"
        WindowStartupLocation="CenterOwner"
        Width="640" Height="420">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock x:Name="tbMessage" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListBox x:Name="lbReferences" Grid.Row="1"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="btnConfirm" Click="Confirm_Click"/>
            <Button Content="Ignore" Click="Ignore_Click"/>
            <Button Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
