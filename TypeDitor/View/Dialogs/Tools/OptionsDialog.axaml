<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TypeDitor.ViewModel.Dialogs.Tools"
        mc:Ignorable="d"
        x:Class="TypeDitor.View.Dialogs.Tools.OptionsDialog"
        x:DataType="vm:OptionsDialogViewModel"
        Title="Options"
        Height="600" Width="900"
        MinHeight="450" MinWidth="700">
    <Grid ColumnDefinitions="230,*">
        <Border Grid.Column="0" BorderBrush="#808080" BorderThickness="0,0,1,0" Padding="10">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="All settings"
                        Click="AllSettings_Click" Margin="0,0,0,8"/>
                <TreeView ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="4"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ShortcutError}"
                       Foreground="#D32F2F" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayedCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Name}" FontSize="18"
                                           FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#707070" BorderThickness="0,0,0,1"
                                                    Padding="4,8">
                                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                               Margin="0,3,12,0" TextWrapping="Wrap"
                                                               Foreground="#777777"/>
                                                    <TextBox Grid.Column="1" Grid.RowSpan="2"
                                                             Name="ValueBox" Text="{Binding Value, Mode=TwoWay}"
                                                             IsReadOnly="{Binding IsShortcut}"
                                                             Watermark="Press a key combination"
                                                             MinWidth="220" VerticalAlignment="Center"
                                                             KeyDown="ValueBox_KeyDown"/>
                                                    <Button Grid.Column="2" Grid.RowSpan="2"
                                                            Content="Revert" IsEnabled="{Binding CanRevert}"
                                                            Click="Revert_Click" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                               Text="Focus the field and press the desired shortcut. Backspace or Delete clears it."
                                                               IsVisible="{Binding IsShortcut}" FontSize="11"
                                                               Foreground="#777777" Margin="4,4,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="#505050" Margin="0,12,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
