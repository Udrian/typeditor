<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TypeDitor.ViewModel.Dialogs.Tools"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TypeDitor.View.Dialogs.Tools.ModulesDialog"
        x:DataType="vm:ModulesDialogViewModel"
        Title="Modules"
        Height="450" Width="800">
    <DockPanel Margin="25">
        <TextBlock DockPanel.Dock="Top" FontSize="32">Modules</TextBlock>
        <Separator DockPanel.Dock="Top" Margin="0,0,0,25"/>

        <Grid DockPanel.Dock="Right" Margin="25,0,0,0" VerticalAlignment="Stretch" IsVisible="{Binding SelectedModuleVisibility}" IsEnabled="{Binding Idle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" DataContext="{Binding SelectedModule}" Text="{Binding Name}"/>
            <TextBlock Grid.Row="1" Foreground="Gray" DataContext="{Binding SelectedModule}" Text="{Binding DisplayVersion}"/>
            <ComboBox Grid.Row="2" DataContext="{Binding SelectedModule}" ItemsSource="{Binding Versions}" SelectedValue="{Binding Version}"/>
            <TextBlock Grid.Row="3" MaxWidth="175" Margin="0,5" TextWrapping="Wrap" Foreground="Orange" VerticalAlignment="Top"
                       DataContext="{Binding SelectedModule}" Text="{Binding Warning}" IsVisible="{Binding HasWarning}"/>
            <StackPanel Grid.Row="4">
                <Button Content="_Install" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="InstallButton_Click" IsVisible="{Binding !IsCurrentModuleInstalled}" />
                <Button Content="Upd_ate" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UpdateButton_Click" IsVisible="{Binding IsCurrentModuleOnLatest}" />
                <Button Content="_Uninstall" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UninstallButton_Click" IsVisible="{Binding IsCurrentModuleInstalled}" />
                <Button Content="Use _local..." Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UseLocal_Click" IsVisible="{Binding !IsCurrentModuleLocal}" />
                <Button Content="Use _released" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UseReleased_Click" IsVisible="{Binding IsCurrentModuleLocal}" />
                <Button Content="Update local _dependencies" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UpdateLocalDependencies_Click" IsVisible="{Binding IsCurrentModuleLocal}" />
            </StackPanel>
        </Grid>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="{Binding Idle}">
            <Button DockPanel.Dock="Right" Content="_New module..." Margin="10,0,0,0" Click="NewModule_Click" />
            <TextBox Name="NewModuleName" PlaceholderText="Name of new module"/>
        </DockPanel>

        <ListBox Name="ModuleList" ItemsSource="{Binding Modules}" SelectionChanged="ModuleList_SelectionChanged" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox IsChecked="{Binding Enabled}" IsEnabled="False" VerticalAlignment="Center" Grid.RowSpan="2" />
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" />
                        <TextBlock Grid.Column="2" Grid.Row="1" FontSize="10" Foreground="LightGray" Text="{Binding DisplayVersion}" />
                        <TextBlock Grid.Column="3" Grid.Row="2" FontSize="10" Foreground="LightBlue" Text="Transitive" IsVisible="{Binding IsTransitive}" />
                        <TextBlock Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" FontSize="16" Foreground="Orange"
                                   Text="&#9888;" IsVisible="{Binding HasWarning}" ToolTip.Tip="{Binding Warning}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
