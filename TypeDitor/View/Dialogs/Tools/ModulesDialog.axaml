<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TypeDitor.ViewModel.Dialogs.Tools"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:TypeDitor.View.Dialogs.Tools"
        x:Class="TypeDitor.View.Dialogs.Tools.ModulesDialog"
        x:DataType="vm:ModulesDialogViewModel"
        Title="Modules"
        Height="450" Width="800">
    <DockPanel Margin="25">
        <TextBlock DockPanel.Dock="Top" FontSize="32">Modules</TextBlock>
        <Separator DockPanel.Dock="Top" Margin="0,0,0,25"/>

        <Grid DockPanel.Dock="Right" VerticalAlignment="Stretch" IsVisible="{Binding SelectedModuleVisibility}" IsEnabled="{Binding Idle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" DataContext="{Binding SelectedModule}" Text="{Binding Name}"/>
            <Separator Grid.Row="1" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="2" Foreground="Gray" DataContext="{Binding SelectedModule}" Text="{Binding DisplayVersion}"/>
            <ComboBox Grid.Row="3" DataContext="{Binding SelectedModule}" ItemsSource="{Binding Versions}" SelectedValue="{Binding Version}"/>
            <Button Grid.Row="5" Content="_Install" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="InstallButton_Click" />
            <Button Grid.Row="6" Content="Upd_ate" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UpdateButton_Click" />
            <Button Grid.Row="7" Content="_Uninstall" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UninstallButton_Click" />
            <Button Grid.Row="8" Content="Use _local..." Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UseLocal_Click" />
            <StackPanel Grid.Row="9">
                <Button Content="Use _released" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UseReleased_Click" />
                <Button Content="Update local _dependencies" Width="175" Margin="0,2" HorizontalAlignment="Center" Click="UpdateLocalDependencies_Click" />
            </StackPanel>
        </Grid>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="{Binding Idle}">
            <Button DockPanel.Dock="Right" Content="_New module..." Margin="10,0,0,0" Click="NewModule_Click" />
            <TextBox Name="NewModuleName" PlaceholderText="Name of new module"/>
        </DockPanel>


        <ListBox Name="ModuleList"  ItemsSource="{Binding Modules}" SelectionChanged="ModuleList_SelectionChanged" >
            <!--<Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>-->

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <CheckBox IsChecked="{Binding Enabled}" IsEnabled="False" VerticalAlignment="Center" Grid.RowSpan="2" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" Grid.Row="1" FontSize="10" Foreground="DimGray" Text="{Binding DisplayVersion}" />
                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
