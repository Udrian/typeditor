<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TypeDitor.View.Dialogs.Tools.AboutDialog"
        Title="About TypeDitor" Width="560" Height="600" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="OnClose"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,0,12,0">
                <TextBlock Text="TypeDitor" FontSize="24" FontWeight="Bold"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Application" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TypeDitorVersion"/>
                    <TextBlock x:Name="TypeDitorBuild" FontSize="12" Opacity="0.7"/>
                    <Button Content="TypeDitor on GitHub" Tag="https://github.com/Udrian/typeditor"
                            HorizontalAlignment="Left" Padding="0" Click="OpenLink_Click"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="TypeD engine" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TypeDVersion"/>
                    <TextBlock x:Name="TypeDBuild" FontSize="12" Opacity="0.7"/>
                    <Button Content="TypeD on GitHub" Tag="https://github.com/Udrian/typed"
                            HorizontalAlignment="Left" Padding="0" Click="OpenLink_Click"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Author and contact" FontWeight="SemiBold"/>
                    <TextBlock Text="Simon Blixt Haggren"/>
                    <Button Content="GitHub: @Udrian" Tag="https://github.com/Udrian"
                            HorizontalAlignment="Left" Padding="0" Click="OpenLink_Click"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Environment" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProjectName"/>
                    <TextBlock x:Name="RuntimeInfo" FontSize="12" Opacity="0.7"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Loaded modules" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NoModulesText" Text="No modules are loaded for this project."
                               FontSize="12" Opacity="0.7"/>
                    <ItemsControl x:Name="ModulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,6" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="{Binding Name}" Tag="{Binding GitPage}"
                                                IsEnabled="{Binding HasGitPage}"
                                                HorizontalAlignment="Left" Padding="0"
                                                Click="OpenLink_Click"/>
                                        <TextBlock Text="{Binding Version}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildDescription}" FontSize="11" Opacity="0.7"
                                               IsVisible="{Binding HasBuildDescription}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
