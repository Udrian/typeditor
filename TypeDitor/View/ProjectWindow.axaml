<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TypeDitor.ViewModel"
        xmlns:local="clr-namespace:TypeDitor.Models"
        mc:Ignorable="d"
        x:Class="TypeDitor.View.ProjectWindow"
        x:DataType="vm:ProjectWindowViewModel"
        Title="TypeDitor Projects"
        Height="620" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Opened="Window_Opened"
        Closing="Window_Closing">
    <Window.Styles>
        <Style Selector="ListBox#ProjectList ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu">
                <Template>
                    <ContextMenu Opening="ProjectContextMenu_Opening">
                        <MenuItem Header="Open" Click="OpenProject_Click"/>
                        <MenuItem Header="Rename..." Click="RenameProject_Click"/>
                        <MenuItem Header="Delete..." Click="DeleteProject_Click"/>
                        <Separator/>
                        <MenuItem Header="Update Modules..." Click="UpdateModules_Click"/>
                    </ContextMenu>
                </Template>
            </Setter>
        </Style>
        <Style Selector="StackPanel#ProjectActions > Button">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>
    <Grid Margin="24" RowDefinitions="Auto,*">
        <StackPanel Spacing="6">
            <TextBlock Text="Projects" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a project to open, or create or import one." Opacity="0.7"/>
            <Separator Margin="0,10,0,14"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,260" RowDefinitions="*,Auto" ColumnSpacing="20">
            <Grid Grid.RowSpan="2" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Discovered projects" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Refresh" Click="RefreshProjects_Click"
                            IsEnabled="{Binding !IsScanning}"/>
                </Grid>
                <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                         DoubleTapped="ProjectList_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:DiscoveredProject">
                            <Grid Margin="6,5" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding FormatStatusTip}">
                                    <TextBlock Text="{Binding CompatibilityText}" FontSize="11" Opacity="0.65"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding FormatStatusText}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="#C77B00" IsVisible="{Binding HasFormatWarning}"/>
                                    <TextBlock Text="{Binding FormatStatusText}" FontSize="11" HorizontalAlignment="Right"
                                               Opacity="0.65" IsVisible="{Binding !HasFormatWarning}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding ScanStatus}" FontSize="12" Opacity="0.7"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Text="{Binding ScanWarnings}" FontSize="11" Foreground="#C77B00"
                           TextWrapping="Wrap" IsVisible="{Binding HasScanWarnings}"/>
            </Grid>
            <StackPanel x:Name="ProjectActions" Grid.Row="0" Grid.Column="1" Spacing="9">
                <Button Content="Open selected project" Command="{Binding OpenProjectCommand}"
                        CommandParameter="{Binding SelectedProject.ProjectFilePath}"
                        IsEnabled="{Binding HasSelectedProject}"/>
                <Button Content="Open project file..." Command="{Binding OpenProjectCommand}"/>
                <Button Content="Import project..." Command="{Binding ImportProjectCommand}"/>
                <Button Content="Create new project..." Command="{Binding NewProjectCommand}"/>
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="1" Content="&#x2699;" ToolTip.Tip="Options"
                    Click="Options_Click" Width="42" Height="42" FontSize="22"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
