<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TypeDitor.View.Panels.PropertyTemplates">
    <DataTemplate x:Key="DoublePropertyTemplate">
        <local:NumericTextBox Text="{Binding Value}"
                              Classes="PropertyInput"
                              AllowNegative="True"
                              AllowDecimals="True"
                              IsReadOnly="{Binding ReadOnly}"/>
    </DataTemplate>
</ResourceDictionary>
