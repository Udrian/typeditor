<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TypeDitor.View.Panels.PropertyTemplates">
    <local:DoubleStringConverter x:Key="DoubleStringConverter" />

    <DataTemplate x:Key="Vec2PropertyTemplate">
        <Grid Classes="PropertyInput">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="X:" />
            <local:NumericTextBox Grid.Column="1"
                                  Text="{Binding ValueX, Mode=TwoWay, Converter={StaticResource DoubleStringConverter}}"
                                  AllowNegative="True"
                                  AllowDecimals="True"
                                  IsReadOnly="{Binding ReadOnly}"/>

            <Label Grid.Column="2" Content="Y:" />
            <local:NumericTextBox Grid.Column="3"
                                  Text="{Binding ValueY, Mode=TwoWay, Converter={StaticResource DoubleStringConverter}}"
                                  AllowNegative="True"
                                  AllowDecimals="True"
                                  IsReadOnly="{Binding ReadOnly}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
