<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="FolderListPropertyTemplate">
        <StackPanel Spacing="6">
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                     Height="110" IsEnabled="{Binding !ReadOnly}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Content="Add folder..." Command="{Binding AddFolderCommand}" IsEnabled="{Binding !ReadOnly}"/>
                <Button Content="Remove" Command="{Binding RemoveFolderCommand}"
                        IsEnabled="{Binding CanRemoveFolder}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="11"
                       TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
