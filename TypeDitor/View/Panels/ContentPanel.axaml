<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDitor.ViewModel.Panels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:TypeDitor.View.Panels"
             x:Class="TypeDitor.View.Panels.ContentPanel"
             x:DataType="vm:ContentPanelViewModel">
    <Grid ColumnDefinitions="200,Auto,*" Margin="8">
    <TreeView x:Name="FolderTree" ItemsSource="{Binding FolderNodes}"
              SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
              DragDrop.AllowDrop="True"
              GotFocus="FolderTree_GotFocus"
              KeyDown="FolderTree_KeyDown">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
            </Style>
        </TreeView.Styles>
        <TreeView.ContextMenu>
            <ContextMenu Opening="FolderMenu_Opening">
                <MenuItem Header="New Folder" Click="NewFolder_Click"/>
                <MenuItem x:Name="FolderRenameItem" Header="Rename" InputGesture="F2" Click="FolderRename_Click"/>
                <MenuItem Header="Show in Explorer" Click="FolderShowInExplorer_Click"/>
                <MenuItem x:Name="FolderDeleteItem" Header="Delete" InputGesture="Delete" Click="FolderDelete_Click"/>
            </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Nodes}">
                <Grid Background="Transparent">
                    <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsEditing}"/>
                    <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}"
                             KeyDown="FolderNameEditor_KeyDown" LostFocus="FolderNameEditor_LostFocus"/>
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
    <GridSplitter Grid.Column="1" Width="5" Background="Transparent"/>
    <Grid Grid.Column="2" RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="300" PlaceholderText="Search..." Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Clear" Command="{Binding ClearSearchCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="ContentList" Margin="0,8,0,0" Background="Transparent"
                 ItemsSource="{Binding FilteredItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 GotFocus="ContentList_GotFocus"
                 KeyDown="ContentList_KeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ContextMenu>
                <ContextMenu Opening="ContextMenu_Opening">
                    <MenuItem Header="Rename" InputGesture="F2" Click="Rename_Click"/>
                    <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click"/>
                    <MenuItem Header="Delete" InputGesture="Delete" Click="Delete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="160" Margin="4" Background="Transparent">
                        <Grid Height="110" Background="Transparent" ToolTip.Tip="{Binding ToolTipContent}">
                        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <Image Source="{Binding TypeIcon}" Width="16" Height="16" Margin="5"
                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsEditing}" Margin="2,4,2,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}" Margin="0,4,0,0"
                                 KeyDown="NameEditor_KeyDown" LostFocus="NameEditor_LostFocus"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
    </Grid>
</UserControl>
