<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDitor.ViewModel.Panels"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             xmlns:local="clr-namespace:TypeDitor.View.Panels"
             x:Class="TypeDitor.View.Panels.ComponentBrowserPanel"
             x:DataType="vm:ComponentBrowserViewModel"
             MinWidth="100">
    <TreeView Name="TreeView" ItemsSource="{Binding Nodes}"
              DoubleTapped="TreeViewItem_MouseDoubleClickEvent"
              SelectionChanged="TreeView_SelectionChanged"
              GotFocus="TreeView_GotFocus"
              KeyDown="TreeView_KeyDown">
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Nodes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16"/>
                    <TextBlock Grid.Column="2" Text="{Binding Name}"/>
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
        
        <TreeView.ContextMenu>
            <ContextMenu Opening="ContextMenu_Opening"/>
        </TreeView.ContextMenu>
    </TreeView>
</UserControl>
