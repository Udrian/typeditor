<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             xmlns:local="clr-namespace:TypeDitor.View.Panels"
             x:Class="TypeDitor.View.Panels.OutputPanel"
             Unloaded="Panel_Unloaded">
    <Grid>
        <TextBox
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            Name="tbOutputText" TextChanged="tbOutputText_TextChanged" IsReadOnly="True" Text="{Binding OutputText}"/>
    </Grid>
</UserControl>
