<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>Simon Haggren</Authors>
		<Company>Typedeaf</Company>
		<Product>TypeO</Product>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Branding\DefaultIcon.ico</ApplicationIcon>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<NoWarn>$(NoWarn);AVLN3001</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<AvaloniaResource Include="Icons\**"/>
		<AvaloniaResource Include="Branding\**"/>
		<Content Include="DefaultIcons\**" CopyToOutputDirectory="PreserveNewest"/>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.4"/>
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4"/>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
		<PackageReference Include="Dock.Avalonia" Version="12.1.0.13"/>
		<PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.13"/>
		<PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.13"/>
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.13"/>
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
		<PackageReference Include="MessageBox.Avalonia" Version="12.1.0"/>
	</ItemGroup>
	<ItemGroup Label="TypeOModules">
		<ProjectReference Name="TypeD" Include="D:/projects/typeo/typed/TypeD/TypeD.csproj"/>
		<ProjectReference Name="TypeOCore" Include="D:/projects/typeo/typeocore/TypeOCore/TypeOCore.csproj"/>
		<ProjectReference Name="TypeDCore" Include="D:/projects/typeo/typeocore/TypeDCore/TypeDCore.csproj"/>
		<ProjectReference Name="TypeOTK" Include="D:/projects/typeo/typeotk/TypeOTK/TypeOTK.csproj"/>
		<ProjectReference Name="TypeDTK" Include="D:/projects/typeo/typeotk/TypeDTK/TypeDTK.csproj"/>
		<ProjectReference Name="TypeOBasic2d" Include="D:/projects/typeo/typeobasic2d/TypeOBasic2d/TypeOBasic2d.csproj"/>
		<ProjectReference Name="TypeDBasic2d" Include="D:/projects/typeo/typeobasic2d/TypeDBasic2d/TypeDBasic2d.csproj"/>
		<ProjectReference Name="TypeODesktop" Include="D:/projects/typeo/typeodesktop/TypeODesktop/TypeODesktop.csproj"/>
	</ItemGroup>
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
		<Exec Command="cmd /c &quot;$(ProjectDir)../typer/typer.bat dependency -p $(ProjectDir)../&quot;"/>
	</Target>
</Project>