<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TypeDater.View.MainWindow"
        Width="560" Height="420" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="TypeDater">
  <Grid Margin="20">

    <!-- Clean install configuration -->
    <StackPanel x:Name="ConfigPanel" Spacing="12" IsVisible="False">
      <TextBlock FontSize="20" FontWeight="Bold" Text="Install TypeDitor" />
      <TextBlock TextWrapping="Wrap"
                 Text="TypeDater will download, build and install the latest version of TypeDitor on this computer." />
      <TextBlock Text="Install location:" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="InstallPathBox" Grid.Column="0" />
        <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Content="Browse..." />
      </Grid>
      <CheckBox x:Name="StartMenuCheck" Content="Create Start menu shortcut" IsChecked="True" />
      <CheckBox x:Name="DesktopCheck" Content="Create desktop shortcut" IsChecked="True" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="InstallButton" Content="Install" Classes="accent" />
        <Button x:Name="CancelButton" Content="Cancel" />
      </StackPanel>
    </StackPanel>

    <!-- Update prompt -->
    <StackPanel x:Name="PromptPanel" Spacing="12" IsVisible="False" VerticalAlignment="Center">
      <TextBlock FontSize="20" FontWeight="Bold" Text="TypeDitor update available" />
      <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="UpdateYesButton" Content="Update" Classes="accent" />
        <Button x:Name="UpdateSkipButton" Content="Skip this version" />
        <Button x:Name="UpdateNoButton" Content="Not now" />
      </StackPanel>
    </StackPanel>

    <!-- Progress -->
    <Grid x:Name="ProgressPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="False">
      <TextBlock x:Name="StepTitle" FontSize="16" FontWeight="Bold" Text="Preparing..." />
      <ProgressBar x:Name="StepProgress" Grid.Row="1" Minimum="0" Maximum="1" Height="8" Margin="0,12" />
      <TextBlock x:Name="DetailText" Grid.Row="2" TextTrimming="CharacterEllipsis" Opacity="0.7" />
      <TextBox x:Name="LogBox" Grid.Row="3" Margin="0,8" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CloseButton" Content="Close" IsVisible="False" />
      </StackPanel>
    </Grid>

  </Grid>
</Window>
